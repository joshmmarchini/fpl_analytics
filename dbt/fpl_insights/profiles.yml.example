# Copy this file to ~/.dbt/profiles.yml and update the path to match your system.
#
# On Windows: C:\Users\<username>\.dbt\profiles.yml
# On Mac/Linux: ~/.dbt/profiles.yml

fpl_insights:
  outputs:
    dev:
      type: duckdb
      # Update this path to point to your local fpl_analytics directory
      path: /path/to/fpl_analytics/duckdb/fpl-insights.duckdb
      schema: analytics
      threads: 4

  target: dev
